# Client (inlined by Vinext — restart dev after changes)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Server / Worker auth (used by API routes; restart dev after changes)
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Optional alias — if unset, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is used for Worker bindings
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
