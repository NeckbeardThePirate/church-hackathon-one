# Workers AI + remote R2/D1 in local dev use your Cloudflare account.
#   CLOUDFLARE_API_TOKEN=...   # Workers Scripts, D1, R2, Vectorize, Workers AI, Queues
#   CLOUDFLARE_ACCOUNT_ID=<YOUR_ACCOUNT_ID>   (or set in .env.local)
#
# Loopback only. Never set these in production.
# DEV_AUTH=1
# MOCK_AI=1
#
# Session cookie HMAC. Required on any public host. Generate a long random string.
# SESSION_SECRET=
#
# Sign in with ChatGPT. Website clients need a registered OAuth client (no secret for a public PKCE client).
# OPENAI_CLIENT_ID=
# OPENAI_CLIENT_SECRET=
# Optional Responses API model. Used only after Workers AI fails, and only if the user granted ChatGPT plan usage.
# LEARN_CHATGPT_MODEL=
#
# AI Gateway `study-buddy` has authentication on. Without the token, calls fall back to Workers AI directly.
# AI_GATEWAY_TOKEN=
#
# Clerk (optional). Also set NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in .env.local.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
#
# Optional. Plans still build from Scripture, confessions, fathers, Wikipedia, and Open Library without these.
# EXA_API_KEY=
# BRAVE_SEARCH_API_KEY=
# ADMIN_TOKEN=
#
# LEARN_MODEL_PLANNER=@cf/zai-org/glm-5.3-flash
# LEARN_MODEL_WORKER=@cf/zai-org/glm-5.3-flash
