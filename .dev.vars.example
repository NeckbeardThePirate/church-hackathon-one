# Workers AI + remote R2/D1 in local dev use your Cloudflare account.
#   CLOUDFLARE_API_TOKEN=...   # Workers Scripts, D1, R2, Vectorize, Workers AI, Queues
#   CLOUDFLARE_ACCOUNT_ID=<YOUR_ACCOUNT_ID>   (or set in .env.local)
#
# Loopback only. Never set these in production.
# DEV_AUTH=1
# MOCK_AI=1
#
# Session cookie HMAC. Required on any public host. Generate a long random string.
# SESSION_SECRET=
#
# Sign in with ChatGPT. Optional at deploy. A public host needs a registered OAuth client.
# Public PKCE clients leave the secret unset. A confidential client needs the secret or sign-in fails with a clear error.
# OPENAI_CLIENT_ID=
# OPENAI_CLIENT_SECRET=
# ChatGPT plan fallback model. Plain Worker var (gpt-6-luna), not a secret. Override only if you change cloudflare.config.ts.
#
# AI Gateway `study-buddy` has authentication on. Without the token, calls fall back to Workers AI directly.
# AI_GATEWAY_TOKEN=
#
# Clerk secret is optional locally. The publishable key is a plain var in cloudflare.config.ts.
# Also set NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in .env.local when you want it inlined at build time.
# CLERK_SECRET_KEY=
#
# Optional. Exa calls go through AI Gateway (custom provider slug `exa`) with AI_GATEWAY_TOKEN.
# The Exa key is not sent when unset. Brave has no call site; an unset key means Brave is not called.
# EXA_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Gates POST /api/admin/embed-scripture (x-admin-token). Required at deploy.
# ADMIN_TOKEN=
#
# Empty uses Claude Haiku 5.5 (`anthropic/claude-haiku-5.5`) through AI Gateway.
# Set a catalog id to override. Provider-native calls send `claude-haiku-5-5`.
# LEARN_MODEL_PLANNER=
# LEARN_MODEL_WORKER=
